# KumaWatch 環境変数
# 使い方: このファイルを .env.local にコピーして値を入れる
# cp .env.local.example .env.local

# -------- LLM 自治体要約 --------
# Google AI Studio で無料取得: https://aistudio.google.com/apikey
# 設定しない場合は demo モード（自治体マスタの固定文）で動作
GEMINI_API_KEY=

# -------- Web Push 通知 --------
# 未設定の場合: API ルートは 503、購読ボタンは非表示で安全に動作する。
#
# 公開フラグ。"true" の時だけ市町村ページに購読ボタンを出し、subscribe を
# 受け付ける。リリース前は未設定 / false にしておき、公開タイミングで
# Vercel の値を "true" にして再デプロイする。バックエンドと SW は常に稼働。
NEXT_PUBLIC_PUSH_ENABLED=
#
# VAPID 鍵ペアは `npm run gen:vapid` で 1 度だけ生成し、本番は Vercel の
# Environment Variables に登録する (Production / Preview / Development)。
# 鍵は発行後に変更しないこと (既存購読者が全て失効する)。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hashimoto@research-coordinate.co.jp

# 購読の永続化に使う Upstash Redis。Vercel Marketplace から追加すると
# 以下 2 つは Vercel 側に自動投入される。ローカル検証時のみ手で設定。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub Actions (news-flash / sharp9110-flash) が /api/push/dispatch を
# Bearer 認証で叩くための共有シークレット (適当な乱数)。
# Vercel と GitHub Actions Secrets の両方に同じ値を設定する。
PUSH_DISPATCH_SECRET=

# -------- LINE 通知 --------
# Web Push の到達を補完する LINE 公式アカウント通知 (高齢者 / iPhone 向け)。
# 未設定の場合: API ルートは 503、LIFF 登録ページは非表示 (notFound) で安全に動作。
#
# 公開フラグ。"true" のときだけ LIFF 登録ページを表示し subscribe を受け付ける。
# LINE 公式アカウント自体を「テスト中」にしておけば、これが true でも公開範囲は
# アカウント側で絞れる。段階公開はこの 2 段構え。
NEXT_PUBLIC_LINE_ENABLED=
#
# Messaging API チャネル (公式アカウント側) の値。送信と webhook 署名検証に使う。
# LINE Developers → 該当チャネル → Messaging API設定 / チャネル基本設定 で取得。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
#
# LINE ログインチャネルの値。LIFF は Messaging API チャネルに置けないため別途
# 「LINE ログインチャネル」を同一プロバイダーに作り、そこに LIFF アプリを追加する。
# 同一プロバイダーなら userId は Messaging API と一致する。
#   - NEXT_PUBLIC_LIFF_ID … LIFF アプリの ID (liff.init に渡す。クライアント公開)
#   - LINE_LOGIN_CHANNEL_ID … idToken 検証の audience (ログインチャネルの ID)
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
#
# 投稿用 LIFF アプリの ID。登録用 (NEXT_PUBLIC_LIFF_ID) はエンドポイントが
# /line/register 固定のため、/line/submit をエンドポイントにした別の LIFF アプリ
# を同じ LINE ログインチャネル配下に作り、その ID をここに入れる (userId 検証は
# 同一チャネルなので LINE_LOGIN_CHANNEL_ID を共用)。未設定なら登録用にフォールバック。
NEXT_PUBLIC_LIFF_SUBMIT_ID=
#
# LINE 内 (LIFF) 投稿ページ /line/submit の公開フラグ。"true" で表示。
# 「名前も URL も忘れたが LINE に公式アカウントが残っている」人が、リッチメニュー
# 等からそこで投稿できるようにする入口。投稿受付は SUBMIT_ENABLED に従う。
# NEXT_PUBLIC_LINE_ENABLED も "true" が前提 (二段構え)。未設定は OFF。
NEXT_PUBLIC_LINE_SUBMIT_ENABLED=
#
# 通知本文の絶対 URL のベース (LINE は相対パス不可)。未設定なら https://kuma-watch.jp。
NEXT_PUBLIC_SITE_URL=https://kuma-watch.jp
#
# LINE 配信 (/api/line/dispatch) の Bearer 認証は Web Push と同じ
# PUSH_DISPATCH_SECRET を共用する (上で設定済み)。
# 購読・重複送信セットは Upstash を Web Push と共用 ("l" プレフィクスで分離)。

# -------- 通知導線 UI --------
# 地図トップ (/) の右下スタックに常設「通知」ボタンを出すか。既定オン。
# 隠したいときだけ "false" を設定する。実際に何を出すか (LINE / ブラウザ通知) は
# LINE_ENTRY / GEO_PUSH の各フラグと LIFF 設定に従う (このフラグは入口の表示可否
# だけを持つ)。
NEXT_PUBLIC_MAP_NOTIFY_FAB=

# -------- 市民投稿 (/submit) --------
# 投稿受付の公開フラグ。"1" のときだけ /api/submit が投稿を受け付ける。
# 本番は当面未設定 (=「準備中」表示) にしておき、テスト後に "1" にして公開。
SUBMIT_ENABLED=
# 投稿モデレーション画面 (/admin/submissions) の合言葉。Bearer 認証に使う。
ADMIN_SECRET=
# 投稿写真の保存先 (Vercel Blob)。Storage で Blob ストアを作成し
# プロジェクトに接続すると自動投入される。未設定なら写真はスキップして動作。
BLOB_READ_WRITE_TOKEN=
# 投稿の永続化・承認待ち管理にも上記 Upstash Redis を利用する。

# -------- 将来用 --------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
