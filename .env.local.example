# KumaWatch 環境変数
# 使い方: このファイルを .env.local にコピーして値を入れる
# cp .env.local.example .env.local

# -------- LLM 自治体要約 --------
# Google AI Studio で無料取得: https://aistudio.google.com/apikey
# 設定しない場合は demo モード（自治体マスタの固定文）で動作
GEMINI_API_KEY=

# -------- Web Push 通知 --------
# 未設定の場合: API ルートは 503、購読ボタンは非表示で安全に動作する。
#
# 公開フラグ。"true" の時だけ市町村ページに購読ボタンを出し、subscribe を
# 受け付ける。リリース前は未設定 / false にしておき、公開タイミングで
# Vercel の値を "true" にして再デプロイする。バックエンドと SW は常に稼働。
NEXT_PUBLIC_PUSH_ENABLED=
#
# VAPID 鍵ペアは `npm run gen:vapid` で 1 度だけ生成し、本番は Vercel の
# Environment Variables に登録する (Production / Preview / Development)。
# 鍵は発行後に変更しないこと (既存購読者が全て失効する)。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hashimoto@research-coordinate.co.jp

# 購読の永続化に使う Upstash Redis。Vercel Marketplace から追加すると
# 以下 2 つは Vercel 側に自動投入される。ローカル検証時のみ手で設定。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub Actions (news-flash / sharp9110-flash) が /api/push/dispatch を
# Bearer 認証で叩くための共有シークレット (適当な乱数)。
# Vercel と GitHub Actions Secrets の両方に同じ値を設定する。
PUSH_DISPATCH_SECRET=

# -------- 将来用 --------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
